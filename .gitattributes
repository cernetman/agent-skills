# Normalize line endings: always LF inside the repo, except for Windows-only scripts
# This way .mjs/.py files cloned on Windows still run correctly on Linux/macOS
* text=auto eol=lf

*.png binary
*.jpg binary
*.zip binary
*.mp4 binary
*.ico binary

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
